{
  "name": "function-bookmarks",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.6.0",
  "publisher": "whlshy",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F3B4D",
    "theme": "dark"
  },
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whlshy/function-bookmarks.git"
  },
  "bugs": {
    "url": "https://github.com/whlshy/function-bookmarks/issues"
  },
  "homepage": "https://github.com/whlshy/function-bookmarks#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "bookmarks",
    "bookmark",
    "functions",
    "symbols",
    "outline",
    "navigation",
    "git",
    "branch",
    "django",
    "markdown",
    "jquery",
    "ajax",
    "numbered bookmarks",
    "share"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "functionBookmarks",
          "title": "%container.title%",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "functionBookmarks": [
        {
          "id": "functionBookmarks.tree",
          "name": "%view.tree.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "functionBookmarks.refresh",
        "title": "%command.refresh%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "functionBookmarks.revealSymbol",
        "title": "%command.revealSymbol%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.openFavorite",
        "title": "%command.revealSymbol%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.openTemplate",
        "title": "%command.openTemplate%",
        "category": "%command.category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "functionBookmarks.addFavorite",
        "title": "%command.addFavorite%",
        "category": "%command.category%",
        "icon": "$(star-empty)"
      },
      {
        "command": "functionBookmarks.removeFavorite",
        "title": "%command.removeFavorite%",
        "category": "%command.category%",
        "icon": "$(star-full)"
      },
      {
        "command": "functionBookmarks.toggleFavorite",
        "title": "%command.toggleFavorite%",
        "category": "%command.category%",
        "icon": "$(star)"
      },
      {
        "command": "functionBookmarks.renameDisplayName",
        "title": "%command.renameDisplayName%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "functionBookmarks.editNote",
        "title": "%command.editNote%",
        "category": "%command.category%",
        "icon": "$(note)"
      },
      {
        "command": "functionBookmarks.previewNote",
        "title": "%command.previewNote%",
        "category": "%command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "functionBookmarks.goToReferenceLine",
        "title": "%command.goToReferenceLine%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.goToParentBlock",
        "title": "%command.goToParentBlock%",
        "category": "%command.category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "functionBookmarks.showAll",
        "title": "%command.showAll%",
        "category": "%command.category%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "functionBookmarks.searchFunctions",
        "title": "%command.searchFunctions%",
        "category": "%command.category%",
        "icon": "$(search)"
      },
      {
        "command": "functionBookmarks.revealLine",
        "title": "%command.revealSymbol%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.toggleBookmark",
        "title": "%command.toggleBookmark%",
        "category": "%command.category%",
        "icon": "$(bookmark)"
      },
      {
        "command": "functionBookmarks.addLabeledBookmark",
        "title": "%command.addLabeledBookmark%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.renameBookmark",
        "title": "%command.renameBookmark%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "functionBookmarks.setBookmarkBranchOnly",
        "title": "%command.setBookmarkBranchOnly%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.setBookmarkAllBranches",
        "title": "%command.setBookmarkAllBranches%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.hideNotOnBranch",
        "title": "%command.hideNotOnBranch%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.showNotOnBranch",
        "title": "%command.showNotOnBranch%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.cleanBranchRecords",
        "title": "%command.cleanBranchRecords%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.exportBookmarks",
        "title": "%command.exportBookmarks%",
        "category": "%command.category%",
        "icon": "$(export)"
      },
      {
        "command": "functionBookmarks.importBookmarks",
        "title": "%command.importBookmarks%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "functionBookmarks.filterBookmarkSources",
        "title": "%command.filterBookmarkSources%",
        "category": "%command.category%",
        "icon": "$(filter)"
      },
      {
        "command": "functionBookmarks.filterBookmarkSourcesActive",
        "title": "%command.filterBookmarkSourcesActive%",
        "category": "%command.category%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "functionBookmarks.groupBookmarksBySource",
        "title": "%command.groupBookmarksBySource%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.deleteBookmarkSource",
        "title": "%command.deleteBookmarkSource%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.renameBookmarkSource",
        "title": "%command.renameBookmarkSource%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.makeBookmarkMine",
        "title": "%command.makeBookmarkMine%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.moveBookmarkToCursor",
        "title": "%command.moveBookmarkToCursor%",
        "category": "%command.category%",
        "icon": "$(target)"
      },
      {
        "command": "functionBookmarks.editBookmarkTags",
        "title": "%command.editBookmarkTags%",
        "category": "%command.category%",
        "icon": "$(tag)"
      },
      {
        "command": "functionBookmarks.removeBookmark",
        "title": "%command.removeBookmark%",
        "category": "%command.category%",
        "icon": "$(close)"
      },
      {
        "command": "functionBookmarks.clearBookmarksInFile",
        "title": "%command.clearBookmarksInFile%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "functionBookmarks.clearAllBookmarks",
        "title": "%command.clearAllBookmarks%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "functionBookmarks.nextBookmark",
        "title": "%command.nextBookmark%",
        "category": "%command.category%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "functionBookmarks.previousBookmark",
        "title": "%command.previousBookmark%",
        "category": "%command.category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "functionBookmarks.searchBookmarks",
        "title": "%command.searchBookmarks%",
        "category": "%command.category%",
        "icon": "$(list-filter)"
      },
      {
        "command": "functionBookmarks.showBookmarksOnly",
        "title": "%command.showBookmarksOnly%",
        "category": "%command.category%",
        "icon": "$(bookmark)"
      },
      {
        "command": "functionBookmarks.groupBookmarksByTag",
        "title": "%command.groupBookmarksByTag%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.groupBookmarksByFile",
        "title": "%command.groupBookmarksByFile%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.hoverAction",
        "title": "%command.addFavorite%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.setBookmarkNumber",
        "title": "%command.setBookmarkNumber%",
        "icon": "$(symbol-numeric)",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.toggleNumberedBookmark",
        "title": "%command.toggleNumberedBookmark%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.goToNumberedBookmark",
        "title": "%command.goToNumberedBookmark%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.setBookmarkColor",
        "title": "%command.setBookmarkColor%",
        "icon": "$(symbol-color)",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.setTagColor",
        "title": "%command.setTagColor%",
        "icon": "$(symbol-color)",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.hideBookmarkIcons",
        "title": "%command.hideBookmarkIcons%",
        "icon": "$(eye-closed)",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.showBookmarkIcons",
        "title": "%command.showBookmarkIcons%",
        "icon": "$(eye)",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.toggleBookmarkIcons",
        "title": "%command.toggleBookmarkIcons%",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.testDetectionRules",
        "title": "%command.testDetectionRules%",
        "icon": "$(beaker)",
        "category": "%command.category%"
      },
      {
        "command": "functionBookmarks.stopTestingDetectionRules",
        "title": "%command.stopTestingDetectionRules%",
        "icon": "$(beaker-stop)",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "functionBookmarks.searchFunctions",
          "when": "view == functionBookmarks.tree",
          "group": "navigation@1"
        },
        {
          "command": "functionBookmarks.showBookmarksOnly",
          "when": "view == functionBookmarks.tree && functionBookmarks.filterMode == all",
          "group": "navigation@3"
        },
        {
          "command": "functionBookmarks.showAll",
          "when": "view == functionBookmarks.tree && functionBookmarks.filterMode != all",
          "group": "navigation@2"
        },
        {
          "command": "functionBookmarks.refresh",
          "when": "view == functionBookmarks.tree",
          "group": "navigation@9"
        },
        {
          "command": "functionBookmarks.searchBookmarks",
          "when": "view == functionBookmarks.tree",
          "group": "2_bookmarks@1"
        },
        {
          "command": "functionBookmarks.groupBookmarksByTag",
          "when": "view == functionBookmarks.tree && functionBookmarks.bookmarkGrouping != tag",
          "group": "2_bookmarks@2"
        },
        {
          "command": "functionBookmarks.groupBookmarksByFile",
          "when": "view == functionBookmarks.tree && functionBookmarks.bookmarkGrouping != file",
          "group": "2_bookmarks@2"
        },
        {
          "command": "functionBookmarks.filterBookmarkSources",
          "when": "view == functionBookmarks.tree && functionBookmarks.hasSources && !functionBookmarks.sourceFiltered",
          "group": "navigation@4"
        },
        {
          "command": "functionBookmarks.filterBookmarkSourcesActive",
          "when": "view == functionBookmarks.tree && functionBookmarks.sourceFiltered",
          "group": "navigation@4"
        },
        {
          "command": "functionBookmarks.groupBookmarksBySource",
          "when": "view == functionBookmarks.tree && functionBookmarks.hasSources && functionBookmarks.bookmarkGrouping != source",
          "group": "2_bookmarks@2"
        },
        {
          "command": "functionBookmarks.exportBookmarks",
          "when": "view == functionBookmarks.tree",
          "group": "4_share@1"
        },
        {
          "command": "functionBookmarks.importBookmarks",
          "when": "view == functionBookmarks.tree",
          "group": "4_share@2"
        },
        {
          "command": "functionBookmarks.hideNotOnBranch",
          "when": "view == functionBookmarks.tree && !functionBookmarks.hideNotOnBranch",
          "group": "2_bookmarks@3"
        },
        {
          "command": "functionBookmarks.showNotOnBranch",
          "when": "view == functionBookmarks.tree && functionBookmarks.hideNotOnBranch",
          "group": "2_bookmarks@3"
        },
        {
          "command": "functionBookmarks.cleanBranchRecords",
          "when": "view == functionBookmarks.tree",
          "group": "3_clear@0"
        },
        {
          "command": "functionBookmarks.clearAllBookmarks",
          "when": "view == functionBookmarks.tree",
          "group": "3_clear@1"
        },
        {
          "command": "functionBookmarks.goToNumberedBookmark",
          "when": "view == functionBookmarks.tree",
          "group": "2_bookmarks@1"
        },
        {
          "command": "functionBookmarks.hideBookmarkIcons",
          "when": "view == functionBookmarks.tree && !functionBookmarks.iconsHidden",
          "group": "2_bookmarks@4"
        },
        {
          "command": "functionBookmarks.showBookmarkIcons",
          "when": "view == functionBookmarks.tree && functionBookmarks.iconsHidden",
          "group": "2_bookmarks@4"
        },
        {
          "command": "functionBookmarks.setTagColor",
          "when": "view == functionBookmarks.tree",
          "group": "2_bookmarks@5"
        },
        {
          "command": "functionBookmarks.testDetectionRules",
          "when": "view == functionBookmarks.tree && !functionBookmarks.testingRules",
          "group": "5_tools@1"
        },
        {
          "command": "functionBookmarks.stopTestingDetectionRules",
          "when": "view == functionBookmarks.tree && functionBookmarks.testingRules",
          "group": "5_tools@1"
        }
      ],
      "view/item/context": [
        {
          "command": "functionBookmarks.addFavorite",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbSymbol:nofav(?!.*:ref)/",
          "group": "inline@1"
        },
        {
          "command": "functionBookmarks.removeFavorite",
          "when": "view == functionBookmarks.tree && (viewItem =~ /^fbSymbol:fav/ || viewItem =~ /^fbFavorite/)",
          "group": "inline@1"
        },
        {
          "command": "functionBookmarks.goToParentBlock",
          "when": "view == functionBookmarks.tree && viewItem =~ /:override/",
          "group": "inline@2"
        },
        {
          "command": "functionBookmarks.openTemplate",
          "when": "view == functionBookmarks.tree && viewItem =~ /:ref/",
          "group": "inline@2"
        },
        {
          "command": "functionBookmarks.addFavorite",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbSymbol:nofav(?!.*:ref)/",
          "group": "1_favorite@1"
        },
        {
          "command": "functionBookmarks.removeFavorite",
          "when": "view == functionBookmarks.tree && (viewItem =~ /^fbSymbol:fav/ || viewItem =~ /^fbFavorite/)",
          "group": "1_favorite@1"
        },
        {
          "command": "functionBookmarks.renameDisplayName",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbSymbol:(fav|nofav:alias)/",
          "group": "1_favorite@2"
        },
        {
          "command": "functionBookmarks.editNote",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbSymbol:(fav|nofav(:alias)?:note)/",
          "group": "1_favorite@3"
        },
        {
          "command": "functionBookmarks.previewNote",
          "when": "view == functionBookmarks.tree && viewItem =~ /:note/",
          "group": "1_favorite@4"
        },
        {
          "command": "functionBookmarks.goToParentBlock",
          "when": "view == functionBookmarks.tree && viewItem =~ /:override/",
          "group": "2_navigate@1"
        },
        {
          "command": "functionBookmarks.openTemplate",
          "when": "view == functionBookmarks.tree && viewItem =~ /:ref/",
          "group": "2_navigate@1"
        },
        {
          "command": "functionBookmarks.goToReferenceLine",
          "when": "view == functionBookmarks.tree && viewItem =~ /:ref/",
          "group": "2_navigate@2"
        },
        {
          "command": "functionBookmarks.removeBookmark",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "inline@1"
        },
        {
          "command": "functionBookmarks.moveBookmarkToCursor",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark.*:lost/",
          "group": "inline@0"
        },
        {
          "command": "functionBookmarks.moveBookmarkToCursor",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "1_bookmark@0"
        },
        {
          "command": "functionBookmarks.makeBookmarkMine",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark.*:foreign/",
          "group": "1_bookmark@6"
        },
        {
          "command": "functionBookmarks.renameBookmarkSource",
          "when": "view == functionBookmarks.tree && viewItem == fbBmSource:foreign",
          "group": "1_source@1"
        },
        {
          "command": "functionBookmarks.deleteBookmarkSource",
          "when": "view == functionBookmarks.tree && viewItem == fbBmSource:foreign",
          "group": "2_remove@1"
        },
        {
          "command": "functionBookmarks.exportBookmarks",
          "when": "view == functionBookmarks.tree && viewItem == fbBmFile",
          "group": "3_share@1"
        },
        {
          "command": "functionBookmarks.setBookmarkBranchOnly",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/ && viewItem !~ /:branchOnly/",
          "group": "1_bookmark@5"
        },
        {
          "command": "functionBookmarks.setBookmarkAllBranches",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark.*:branchOnly/",
          "group": "1_bookmark@5"
        },
        {
          "command": "functionBookmarks.renameBookmark",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "1_bookmark@1"
        },
        {
          "command": "functionBookmarks.editBookmarkTags",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "1_bookmark@2"
        },
        {
          "command": "functionBookmarks.editNote",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "1_bookmark@3"
        },
        {
          "command": "functionBookmarks.previewNote",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/ && viewItem =~ /:note/",
          "group": "1_bookmark@4"
        },
        {
          "command": "functionBookmarks.removeBookmark",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "2_remove@1"
        },
        {
          "command": "functionBookmarks.clearBookmarksInFile",
          "when": "view == functionBookmarks.tree && viewItem == fbBmFile",
          "group": "2_remove@1"
        },
        {
          "command": "functionBookmarks.setBookmarkNumber",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "1_style@1"
        },
        {
          "command": "functionBookmarks.setBookmarkColor",
          "when": "view == functionBookmarks.tree && viewItem =~ /^fbBookmark/",
          "group": "1_style@2"
        },
        {
          "command": "functionBookmarks.setTagColor",
          "when": "view == functionBookmarks.tree && viewItem == fbBmTag",
          "group": "inline@1"
        },
        {
          "command": "functionBookmarks.setTagColor",
          "when": "view == functionBookmarks.tree && viewItem == fbBmTag",
          "group": "1_tag@1"
        }
      ],
      "editor/context": [
        {
          "command": "functionBookmarks.toggleBookmark",
          "when": "editorTextFocus",
          "group": "functionBookmarks@0"
        },
        {
          "command": "functionBookmarks.addLabeledBookmark",
          "when": "editorTextFocus",
          "group": "functionBookmarks@0"
        },
        {
          "command": "functionBookmarks.toggleFavorite",
          "when": "editorTextFocus",
          "group": "functionBookmarks@1"
        },
        {
          "command": "functionBookmarks.renameDisplayName",
          "when": "editorTextFocus",
          "group": "functionBookmarks@2"
        },
        {
          "command": "functionBookmarks.editNote",
          "when": "editorTextFocus",
          "group": "functionBookmarks@3"
        },
        {
          "command": "functionBookmarks.previewNote",
          "when": "editorTextFocus",
          "group": "functionBookmarks@4"
        },
        {
          "command": "functionBookmarks.setBookmarkNumber",
          "when": "editorTextFocus",
          "group": "functionBookmarks@5"
        },
        {
          "command": "functionBookmarks.setBookmarkColor",
          "when": "editorTextFocus",
          "group": "functionBookmarks@6"
        }
      ],
      "commandPalette": [
        {
          "command": "functionBookmarks.filterBookmarkSourcesActive",
          "when": "false"
        },
        {
          "command": "functionBookmarks.makeBookmarkMine",
          "when": "false"
        },
        {
          "command": "functionBookmarks.revealSymbol",
          "when": "false"
        },
        {
          "command": "functionBookmarks.openFavorite",
          "when": "false"
        },
        {
          "command": "functionBookmarks.openTemplate",
          "when": "false"
        },
        {
          "command": "functionBookmarks.addFavorite",
          "when": "false"
        },
        {
          "command": "functionBookmarks.removeFavorite",
          "when": "false"
        },
        {
          "command": "functionBookmarks.goToReferenceLine",
          "when": "false"
        },
        {
          "command": "functionBookmarks.goToParentBlock",
          "when": "false"
        },
        {
          "command": "functionBookmarks.revealLine",
          "when": "false"
        },
        {
          "command": "functionBookmarks.renameBookmark",
          "when": "false"
        },
        {
          "command": "functionBookmarks.editBookmarkTags",
          "when": "false"
        },
        {
          "command": "functionBookmarks.removeBookmark",
          "when": "false"
        },
        {
          "command": "functionBookmarks.hoverAction",
          "when": "false"
        },
        {
          "command": "functionBookmarks.stopTestingDetectionRules",
          "when": "functionBookmarks.testingRules"
        },
        {
          "command": "functionBookmarks.hideBookmarkIcons",
          "when": "!functionBookmarks.iconsHidden"
        },
        {
          "command": "functionBookmarks.showBookmarkIcons",
          "when": "functionBookmarks.iconsHidden"
        }
      ],
      "explorer/context": [
        {
          "command": "functionBookmarks.exportBookmarks",
          "group": "7_modification@9"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "functionBookmarks.toggleBookmark",
          "group": "functionBookmarks@1"
        },
        {
          "command": "functionBookmarks.addLabeledBookmark",
          "group": "functionBookmarks@2"
        },
        {
          "command": "functionBookmarks.setBookmarkNumber",
          "group": "functionBookmarks@3"
        },
        {
          "command": "functionBookmarks.setBookmarkColor",
          "group": "functionBookmarks@4"
        }
      ]
    },
    "configuration": [
      {
        "id": "functionBookmarks.bookmarks",
        "title": "%config.category.bookmarks%",
        "properties": {
          "functionBookmarks.bookmarks.onLineDelete": {
            "type": "string",
            "enum": [
              "moveToNext",
              "markLost",
              "remove"
            ],
            "enumDescriptions": [
              "%config.onLineDelete.moveToNext%",
              "%config.onLineDelete.markLost%",
              "%config.onLineDelete.remove%"
            ],
            "default": "moveToNext",
            "markdownDescription": "%config.onLineDelete%",
            "order": 0
          },
          "functionBookmarks.bookmarks.autoNumber": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.bookmarks.autoNumber%",
            "order": 1
          },
          "functionBookmarks.bookmarks.showLabelAtLineEnd": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.bookmarks.showLabelAtLineEnd%",
            "order": 2
          },
          "functionBookmarks.statusBar.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.statusBar.enabled%",
            "order": 3
          },
          "functionBookmarks.hover.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.hover.enabled%",
            "order": 4
          },
          "functionBookmarks.followCursor": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.followCursor%",
            "order": 5
          }
        }
      },
      {
        "id": "functionBookmarks.detection",
        "title": "%config.category.detection%",
        "properties": {
          "functionBookmarks.detection.source": {
            "type": "string",
            "enum": [
              "rules",
              "languageServer",
              "both"
            ],
            "enumDescriptions": [
              "%config.detection.source.rules%",
              "%config.detection.source.languageServer%",
              "%config.detection.source.both%"
            ],
            "default": "rules",
            "markdownDescription": "%config.detection.source%",
            "order": 0
          },
          "functionBookmarks.detection.rules": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.detection.rules%",
            "items": {
              "type": "object",
              "required": [
                "id",
                "languages",
                "pattern",
                "kind",
                "body"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "%config.rule.id%"
                },
                "label": {
                  "type": "string",
                  "description": "%config.rule.label%"
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%config.rule.languages%"
                },
                "pattern": {
                  "type": "string",
                  "description": "%config.rule.pattern%"
                },
                "flags": {
                  "type": "string",
                  "description": "%config.rule.flags%"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "function",
                    "method",
                    "class",
                    "block",
                    "partial",
                    "macro",
                    "event",
                    "request",
                    "heading",
                    "reference"
                  ],
                  "description": "%config.rule.kind%"
                },
                "body": {
                  "type": "string",
                  "enum": [
                    "brace",
                    "indent",
                    "pair",
                    "line",
                    "call",
                    "heading",
                    "embedded"
                  ],
                  "description": "%config.rule.body%"
                },
                "end": {
                  "type": "string",
                  "description": "%config.rule.end%"
                },
                "embeddedLanguage": {
                  "type": "string",
                  "description": "%config.rule.embeddedLanguage%"
                },
                "within": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%config.rule.within%"
                },
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%config.rule.include%"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "%config.rule.enabled%"
                },
                "nameTemplate": {
                  "type": "string",
                  "description": "%config.rule.nameTemplate%"
                },
                "matchRaw": {
                  "type": "boolean",
                  "description": "%config.rule.matchRaw%"
                },
                "hideChildren": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%config.rule.hideChildren%"
                }
              }
            },
            "order": 1
          },
          "functionBookmarks.detection.disabledRules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "html-id"
            ],
            "markdownDescription": "%config.detection.disabledRules%",
            "order": 2
          },
          "functionBookmarks.detection.templateFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/templates/**"
            ],
            "markdownDescription": "%config.detection.templateFiles%",
            "order": 3
          },
          "functionBookmarks.django.templateDirs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.django.templateDirs%",
            "order": 4
          }
        }
      },
      {
        "id": "functionBookmarks.project",
        "title": "%config.category.project%",
        "properties": {
          "functionBookmarks.project.include": {
            "type": "string",
            "default": "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,py,html,htm,md,markdown}",
            "markdownDescription": "%config.project.include%",
            "order": 0
          },
          "functionBookmarks.project.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/node_modules/**",
              "**/.git/**",
              "**/.venv/**",
              "**/venv/**",
              "**/env/**",
              "**/__pycache__/**",
              "**/site-packages/**",
              "**/dist/**",
              "**/build/**",
              "**/out/**",
              "**/staticfiles/**",
              "**/.next/**",
              "**/coverage/**",
              "**/*.min.js"
            ],
            "markdownDescription": "%config.project.exclude%",
            "order": 1
          }
        }
      },
      {
        "id": "functionBookmarks.storage",
        "title": "%config.category.storage%",
        "properties": {
          "functionBookmarks.storage": {
            "type": "string",
            "enum": [
              "file",
              "workspaceState"
            ],
            "enumDescriptions": [
              "%config.storage.file%",
              "%config.storage.workspaceState%"
            ],
            "default": "file",
            "markdownDescription": "%config.storage%",
            "order": 0
          },
          "functionBookmarks.authorName": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.authorName%",
            "order": 1
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "functionBookmarks.renameDisplayName",
